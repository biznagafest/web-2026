---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import CommonHead from "../components/CommonHead.astro";
import ButtonUp from "../components/ButtonUp.astro";
import AnimateObserver from "../components/utils/AnimateObserver.astro";
import type { Nullish } from "../utils/nullish";

const { data } = Astro.locals;

export interface Props {
  title: string;
  lang: string;
  description?: Nullish<string>;
  image?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  lang,
  description,
  image,
  noIndex,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <CommonHead
    title={title}
    description={description ?? ""}
    image={image}
    noIndex={noIndex}
    jsonLd={jsonLd}
  />
  <body class="bg-surface-page text-text-primary antialiased">
    <div class="min-h-screen flex flex-col justify-between">
      <div>
        <Navigation />
        <main id="main">
          <slot />
        </main>
      </div>
      <ButtonUp class="fixed bottom-4 right-4 z-30" />
      <Footer />
    </div>
    {data.welcomeBanner.isEnabled && <div class="hidden" aria-hidden="true" />}
    <AnimateObserver />
  </body>
</html>
