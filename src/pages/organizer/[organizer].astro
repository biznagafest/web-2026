---
import { Image } from "astro:assets";
import RichText from "../../components/RichText.astro";
import Socials from "../../components/Socials.astro";
import Layout from "../../layouts/Layout.astro";
import { slugify } from "../../utils/slug";
import { buildBreadcrumbJsonLd, buildPersonJsonLd } from "../../utils/json-ld";

const { data } = Astro.locals;
const { organizer } = Astro.params;

const organizerData = data.team.organizers.find(
  (o) => slugify(o.name) === organizer,
);

if (!organizerData) {
  return Astro.rewrite("/404");
}

const slug = slugify(organizerData.name);

const baseUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, baseUrl);
const jsonLd = [
  buildPersonJsonLd(organizerData, pageUrl, baseUrl),
  buildBreadcrumbJsonLd([
    { name: "Inicio", url: new URL("/", baseUrl) },
    { name: "Equipo", url: new URL("/#team", baseUrl) },
    { name: organizerData.name, url: pageUrl },
  ]),
];
---

<Layout
  title={`${organizerData.name} | ${data.title}`}
  description={organizerData.description}
  image={organizerData.picture}
  ogType="profile"
  jsonLd={jsonLd}
  lang="es"
>
  <main class="flex flex-col gap-12 min-h-screen mx-auto max-w-[1240px] px-6 py-16 md:py-24">
    <aside>
      <div
        class="grid grid-cols-1 lg:grid-cols-[2fr_4fr] gap-6 md:gap-10 lg:gap-12 w-full"
      >
        <section class="w-full flex flex-col gap-5 mx-auto">
          <div class="w-full max-w-[320px] mx-auto flex flex-col gap-5">
            <Image
              transition:name={`picture-organizer-${slug}`}
              class="w-full rounded-md border-2 border-border-highlight aspect-square object-cover"
              src={organizerData.picture}
              alt={`Picture of ${organizerData.name}`}
              loading="eager"
              height={320}
              width={320}
            />
            <Socials
              socials={organizerData.socials}
              class="text-3xl text-text-primary hover:text-accent-yellow transition-colors"
            />
          </div>
        </section>
        <div class="flex flex-col gap-4">
          <h1
            transition:name={`name-organizer-${slug}`}
            class="font-heading text-5xl md:text-7xl font-bold uppercase text-text-primary leading-tight"
          >
            {organizerData.name}
          </h1>
          <h2 class="font-display text-sm md:text-base text-accent-yellow uppercase tracking-pixel">
            {organizerData.position}
          </h2>
          <div
            class="flex flex-col gap-4 font-sans text-base md:text-lg text-text-primary/90 leading-relaxed"
          >
            <RichText text={organizerData.description} />
          </div>
        </div>
      </div>
    </aside>
  </main>
</Layout>
