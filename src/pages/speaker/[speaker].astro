---
import { Image } from "astro:assets";
import EventCard from "../../components/EventCard.astro";
import RichText from "../../components/RichText.astro";
import Socials from "../../components/Socials.astro";
import Layout from "../../layouts/Layout.astro";
import { slugify } from "../../utils/slug";
import { buildBreadcrumbJsonLd, buildPersonJsonLd } from "../../utils/json-ld";

const { data } = Astro.locals;
const { speaker } = Astro.params;

const speakerData = data.speakers.find((s) => slugify(s.name) === speaker);

if (!speakerData) {
  return Astro.rewrite("/404");
}

const slug = slugify(speakerData.name);
const events = data.events.filter((event) =>
  event.speakers.includes(speakerData.name),
);

const baseUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, baseUrl);
const jsonLd = [
  buildPersonJsonLd(speakerData, pageUrl, baseUrl),
  buildBreadcrumbJsonLd([
    { name: "Inicio", url: new URL("/", baseUrl) },
    { name: "Speakers", url: new URL("/#speakers", baseUrl) },
    { name: speakerData.name, url: pageUrl },
  ]),
];
---

<Layout
  title={`${speakerData.name} | ${data.title}`}
  description={speakerData.description}
  image={speakerData.picture}
  ogType="profile"
  jsonLd={jsonLd}
  lang="es"
>
  <main class="flex flex-col gap-12 min-h-screen mx-auto max-w-[1240px] px-6 py-16 md:py-24">
    <aside>
      <div
        class="grid grid-cols-1 lg:grid-cols-[2fr_4fr] gap-6 md:gap-10 lg:gap-12 w-full"
      >
        <section class="w-full flex flex-col gap-5 mx-auto">
          <div class="w-full max-w-[320px] mx-auto flex flex-col gap-5">
            <Image
              transition:name={`picture-speaker-${slug}`}
              class="w-full rounded-md border-2 border-border-highlight aspect-square object-cover"
              src={speakerData.picture}
              alt={`Picture of ${speakerData.name}`}
              height={320}
              width={320}
            />
            <Socials
              socials={speakerData.socials}
              class="text-3xl text-text-primary hover:text-accent-yellow transition-colors"
            />
          </div>
        </section>
        <div class="flex flex-col gap-4">
          <h1
            transition:name={`name-speaker-${slug}`}
            class="font-heading text-5xl md:text-7xl font-bold uppercase text-text-primary leading-tight"
          >
            {speakerData.name}
          </h1>
          <h2 class="font-display text-sm md:text-base text-accent-yellow uppercase tracking-pixel">
            {speakerData.position}
          </h2>
          <div
            class="flex flex-col gap-4 font-sans text-base md:text-lg text-text-primary/90 leading-relaxed"
          >
            <RichText text={speakerData.description} />
          </div>
        </div>
      </div>
    </aside>
    {
      !!events.length && (
        <section class="flex flex-col gap-6">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </section>
      )
    }
  </main>
</Layout>
