---
import { Image } from "astro:assets";
import RichText from "../../components/RichText.astro";
import Socials from "../../components/Socials.astro";
import Layout from "../../layouts/Layout.astro";
import { slugify } from "../../utils/slug";
import { buildBreadcrumbJsonLd, buildPersonJsonLd } from "../../utils/json-ld";

const { data } = Astro.locals;
const { host } = Astro.params;

const hostData = data.hosts.find((h) => slugify(h.name) === host);

if (!hostData) {
  return Astro.rewrite("/404");
}

const slug = slugify(hostData.name);

const baseUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, baseUrl);
const jsonLd = [
  buildPersonJsonLd(hostData, pageUrl, baseUrl),
  buildBreadcrumbJsonLd([
    { name: "Inicio", url: new URL("/", baseUrl) },
    { name: "Hosts", url: new URL("/#hosts", baseUrl) },
    { name: hostData.name, url: pageUrl },
  ]),
];

const seoTitle = hostData.position
  ? `${hostData.name} — ${hostData.position} · Host en ${data.title}`
  : `${hostData.name} · Host en ${data.title}`;
const seoDescription = hostData.description
  ? hostData.description
  : `${hostData.name} forma parte del equipo de hosts y MCs de ${data.title}, el festival tech de la Costa del Sol.`;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={hostData.picture}
  ogType="profile"
  jsonLd={jsonLd}
  lang="es"
>
  <main class="flex flex-col gap-12 min-h-screen mx-auto max-w-[1240px] px-6 py-16 md:py-24">
    <aside>
      <div
        class="grid grid-cols-1 lg:grid-cols-[2fr_4fr] gap-6 md:gap-10 lg:gap-12 w-full"
      >
        <section class="w-full flex flex-col gap-5 mx-auto">
          <Image
            transition:name={`picture-host-${slug}`}
            class="w-full max-w-[320px] mx-auto rounded-md border-2 border-border-highlight aspect-square object-cover"
            src={hostData.picture}
            alt={`Foto de ${hostData.name}${hostData.position ? `, ${hostData.position}` : ""}, host en ${data.title}`}
            height={320}
            width={320}
          />
          <Socials
            socials={hostData.socials}
            class="text-3xl text-text-primary hover:text-accent-yellow transition-colors"
          />
        </section>
        <div class="flex flex-col gap-4">
          <h1
            transition:name={`name-host-${slug}`}
            class="font-heading text-5xl md:text-7xl font-bold uppercase text-text-primary leading-tight"
          >
            {hostData.name}
          </h1>
          <h2 class="font-display text-sm md:text-base text-accent-yellow uppercase tracking-pixel">
            {hostData.position}
          </h2>
          <div
            class="flex flex-col gap-4 font-sans text-base md:text-lg text-text-primary/90 leading-relaxed"
          >
            <RichText text={hostData.description} />
          </div>
        </div>
      </div>
    </aside>
  </main>
</Layout>
