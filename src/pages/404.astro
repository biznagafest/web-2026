---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";

Astro.response.status = 404;
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<Layout
  title="404 — Page not found | BiznagaFest"
  description="La página que buscas no existe o fue movida."
  lang="es"
  noIndex
>
  <main
    class="flex flex-col gap-8 items-center justify-center min-h-[60vh] mx-auto max-w-2xl px-6 py-20 text-center"
  >
    <SectionHeader
      eyebrow="404"
      title="Game Over"
      subtitle="La página que buscas no existe o se ha movido."
      align="center"
      class="mx-auto"
    />
    <a
      href="/"
      class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-action-primary text-text-white font-heading uppercase tracking-wide hover:bg-action-primary-hover transition-colors"
      data-umami-event="404_back_home"
    >
      Volver al inicio
    </a>
  </main>
</Layout>
