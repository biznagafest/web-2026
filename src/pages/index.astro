---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { DATA } from "../data/data";
import biznagaWordmark from "../assets/biznagafest-wordmark.svg";
import Speaker from "../components/Speaker.astro";
import Sponsor from "../components/Sponsor.astro";
import AnimatedOnViewportEnter from "../components/utils/AnimatedOnViewportEnter.astro";
import type { Sponsor as ISponsor, SponsorTier } from "../data/data.type";
import TeamMember from "../components/TeamMember.astro";
import Accordion from "../components/Accordion.astro";
import TicketSection from "../components/TicketSection.astro";
import PretixBuyButton from "../components/PretixBuyButton.astro";
import SponsorDossier from "../components/SponsorDossier.astro";
import Carousel from "../components/Carousel.astro";
import RichText from "../components/RichText.astro";
import Schedule from "../components/Schedule.astro";
import Host from "../components/Host.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatCard from "../components/StatCard.astro";
import SponsorsCta from "../components/SponsorsCta.astro";
import SponsorForm from "../components/integrations/preact/components/SponsorForm";

const heroDateFormatter = new Intl.DateTimeFormat("es-ES", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
const heroDateLabel = heroDateFormatter.format(DATA.date).toUpperCase();

const sponsorTierLabels: Record<SponsorTier, string> = {
  platinum: "GOD TIER",
  gold: "LEGENDARY",
  silver: "EPIC",
  bronze: "RARE",
  communitySponsor: "COMMON",
  media: "MEDIA",
  community: "Partners",
  food: "Food Partners",
  supporter: "Supporters",
};

const sponsorTierOrder: SponsorTier[] = [
  "platinum",
  "gold",
  "silver",
  "bronze",
  "communitySponsor",
  "media",
  "supporter",
  "community",
  "food",
];

const sponsorsByTier: Record<SponsorTier, ISponsor[]> = {
  platinum: [],
  gold: [],
  silver: [],
  bronze: [],
  communitySponsor: [],
  media: [],
  community: [],
  food: [],
  supporter: [],
};

for (const sponsor of DATA.sponsors) {
  sponsorsByTier[sponsor.tier].push(sponsor);
}

const previousEditionStats = [
  { value: "+800", label: "Asistentes" },
  { value: "+12", label: "Speakers" },
  { value: "+12h", label: "Contenido tech" },
  { value: "+60", label: "Sponsors aliados" },
];

const heroStats = [
  { value: "+5.000", label: "Asistentes totales" },
  { value: "+8", label: "Ediciones" },
  { value: "+200", label: "Speakers" },
  { value: "+120", label: "Horas de contenido tech" },
];

const eventStartIso = DATA.date instanceof Date ? DATA.date.toISOString() : "";
const eventEndDate =
  DATA.date instanceof Date
    ? new Date(DATA.date.getTime() + 12 * 60 * 60 * 1000).toISOString()
    : "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: DATA.title,
  description: DATA.description,
  startDate: eventStartIso,
  endDate: eventEndDate,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  image: [new URL("/BIZNAGAFEST-2026-OPENGRAPH.webp", Astro.site ?? Astro.url).toString()],
  location: {
    "@type": "Place",
    name: DATA.venue?.title,
    address: {
      "@type": "PostalAddress",
      streetAddress: DATA.venue?.address,
      addressLocality: DATA.venue?.city,
      addressCountry: "ES",
    },
  },
  organizer: {
    "@type": "Organization",
    name: "GDG Málaga",
    url: "https://gdg.community.dev/gdg-malaga/",
  },
  ...(DATA.ticketsUrl
    ? {
        offers: {
          "@type": "Offer",
          url: DATA.ticketsUrl,
          availability: "https://schema.org/InStock",
          priceCurrency: "EUR",
          validFrom: new Date().toISOString(),
        },
      }
    : {}),
  performer: DATA.speakers?.map((s) => ({
    "@type": "Person",
    name: s.name,
  })),
};
---

<Layout
  title={DATA.title}
  description={DATA.description}
  lang="es"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section id="hero" class="relative overflow-hidden bg-surface-page">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div
        class="absolute inset-0 bg-gradient-to-b from-surface-page via-[#00002d] to-surface-card"
      >
      </div>
      <img
        src="/hero-background.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20"
        loading="eager"
      />
    </div>
    <div
      class="relative mx-auto max-w-[1240px] flex flex-col items-center text-center gap-8 px-6 py-24 md:py-32"
    >
      <span
        class="font-display text-[10px] md:text-xs uppercase tracking-pixel text-text-secondary"
      >
        Costa del Sol · Tech Festival
      </span>
      <h1 class="w-full max-w-[1140px]">
        <Image
          src={biznagaWordmark}
          alt="BiznagaFest 2026"
          class="w-full h-auto"
          loading="eager"
        />
      </h1>
      <div
        class="font-display text-base md:text-xl text-text-primary flex flex-col gap-2"
      >
        <p>{heroDateLabel}</p>
        <p>{DATA.venue.title}</p>
      </div>
      <p
        class="font-display text-xs md:text-sm text-accent-yellow animate-pulse"
      >
        ▸ Are you ready?
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-2">
        <PretixBuyButton
          class="inline-flex items-center justify-center rounded-sm bg-action-primary px-6 py-3 font-sans text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-action-primary-hover"
        />
        {
          !!DATA.schedule.length && (
            <a
              href="#schedule"
              class="inline-flex items-center justify-center rounded-sm border border-border-highlight px-6 py-3 font-sans text-sm font-semibold uppercase tracking-wide text-text-primary transition-colors hover:bg-surface-card"
              data-umami-event="hero_agenda_cta"
            >
              Ver agenda
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- Context + Stats -->
  <section id="about" class="bg-surface-page">
    <div
      class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start"
    >
      <AnimatedOnViewportEnter
        animation="animate__animated animate__fadeInLeft"
      >
        <div class="flex flex-col gap-6">
          <SectionHeader
            eyebrow="El evento"
            title="El gran encuentro tech de la Costa del Sol"
          />
          <div
            class="flex flex-col gap-4 font-sans text-base text-text-primary/85 leading-relaxed [&_u]:text-accent-yellow [&_u]:underline [&_u]:underline-offset-2"
          >
            <RichText text={DATA.description} />
          </div>
        </div>
      </AnimatedOnViewportEnter>
      <AnimatedOnViewportEnter animation="animate__animated animate__fadeInUp">
        <div class="grid grid-cols-2 gap-4">
          {
            heroStats.map((stat) => (
              <StatCard value={stat.value} label={stat.label} />
            ))
          }
        </div>
      </AnimatedOnViewportEnter>
    </div>
  </section>

  <!-- Speakers -->
  {
    !!DATA.speakers.length && (
      <section id="speakers" class="bg-surface-card border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-12">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Fighters"
              title="Speakers"
              subtitle="Referentes del ecosistema tech compartiendo ideas, experiencias y mucho conocimiento."
            />
          </AnimatedOnViewportEnter>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
            {DATA.speakers.map((speaker, index) => (
              <Speaker speaker={speaker} index={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Hosts -->
  {
    !!DATA.hosts.length && (
      <section id="hosts" class="bg-surface-page border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-10">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="The Ringmasters"
              title="Hosts & MCs"
              subtitle="Quienes guían la experiencia, conectan a la comunidad y dan ritmo al evento."
              align="center"
            />
          </AnimatedOnViewportEnter>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            {DATA.hosts.map((host, index) => (
              <Host host={host} index={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Schedule / Agenda -->
  {
    !!DATA.schedule.length && (
      <section id="schedule" class="bg-surface-card border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-12">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Battle Plan"
              title="Agenda"
              subtitle="Charlas, talleres y descansos. Toca cada combate para ver detalles."
            />
          </AnimatedOnViewportEnter>
          <Schedule data={DATA.schedule} />
        </div>
      </section>
    )
  }

  <!-- Tickets -->
  {
    !!DATA.tickets.length && (
      <section id="tickets" class="bg-surface-page border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-10">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Insert Coin"
              title="Elige tu entrada"
              align="center"
            />
          </AnimatedOnViewportEnter>
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeIn">
            <div class="flex flex-col gap-6">
              <TicketSection tickets={DATA.tickets} />
            </div>
          </AnimatedOnViewportEnter>
          {!!DATA.companyTicketsNotice.enabled && (
            <div class="mt-4 mx-auto max-w-3xl relative overflow-hidden rounded-md border border-border-highlight/40 bg-surface-card shadow-[0_4px_16px_rgba(0,0,0,0.45)]">
              <span
                aria-hidden="true"
                class="absolute top-0 left-0 h-[3px] w-full bg-gradient-to-r from-action-secondary via-accent-blue to-accent-yellow"
              />
              <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-6 p-6 md:p-8">
                <div class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-md border border-border-highlight/60 bg-action-secondary/15 text-2xl text-accent-blue">
                  <i class="ph ph-users-three" aria-hidden="true" />
                </div>
                <div class="flex flex-col gap-3 min-w-0">
                  <span class="font-display text-[10px] uppercase tracking-pixel text-accent-blue">
                    Co-op Mode
                  </span>
                  <h3 class="font-heading text-xl md:text-2xl font-bold uppercase text-text-primary tracking-wide leading-tight">
                    {DATA.companyTicketsNotice.title}
                  </h3>
                  <div class="font-sans text-sm md:text-base text-text-primary/85 leading-relaxed [&_a]:text-accent-yellow [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-accent-blue [&_a]:transition-colors">
                    <RichText text={DATA.companyTicketsNotice.description} />
                  </div>
                </div>
              </div>
            </div>
          )}

          {DATA.tshirt && (
            <div class="mt-4 relative overflow-hidden rounded-md border border-border-highlight/40 bg-surface-card shadow-[0_4px_16px_rgba(0,0,0,0.45)]">
              <span
                aria-hidden="true"
                class="absolute top-0 left-0 h-[3px] w-full bg-gradient-to-r from-accent-yellow via-accent-red to-action-secondary"
              />
              <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 lg:gap-10 p-6 md:p-10">
                <div class="flex flex-col gap-3 text-center lg:text-left">
                  <span class="font-display text-[10px] uppercase tracking-pixel text-accent-yellow">
                    Bonus Drop
                  </span>
                  {DATA.tshirt.title && (
                    <h4 class="font-heading text-2xl md:text-3xl font-bold uppercase text-text-primary leading-tight tracking-wide">
                      {DATA.tshirt.title}
                    </h4>
                  )}
                  <span
                    aria-hidden="true"
                    class="hidden lg:block h-[3px] w-14 rounded-sm bg-gradient-to-r from-accent-yellow to-accent-red"
                  />
                  {DATA.tshirt.subtitle && (
                    <p class="font-sans text-sm md:text-base text-text-primary/80 leading-relaxed">
                      {DATA.tshirt.subtitle}
                    </p>
                  )}
                </div>
                <div class="mx-auto w-full max-w-[280px]">
                  <div class="rounded-md p-[2px] bg-gradient-to-br from-accent-yellow via-accent-red to-action-secondary">
                    <div class="rounded-[6px] overflow-hidden bg-surface-page">
                      {DATA.tshirt.type === "image" ? (
                        <img
                          class="w-full aspect-square object-cover"
                          src={DATA.tshirt.url}
                          alt={DATA.tshirt.title ?? "T-shirt"}
                          loading="lazy"
                        />
                      ) : (
                        <video
                          class="w-full aspect-square object-cover"
                          src={DATA.tshirt.url}
                          autoplay
                          loop
                          muted
                          playsinline
                        />
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Sponsors -->
  {
    !!DATA.sponsors.length && (
      <section id="sponsors" class="bg-surface-card border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-12">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Power-ups"
              title="Sponsors"
              subtitle="Empresas y comunidades que impulsan el ecosistema tech y hacen posible BiznagaFest."
            />
          </AnimatedOnViewportEnter>
          {sponsorTierOrder.map((tier) => {
            const tierSponsors = sponsorsByTier[tier];
            if (!tierSponsors.length) return null;
            const cols =
              tier === "platinum" || tier === "gold"
                ? "grid-cols-1 sm:grid-cols-2 md:grid-cols-3"
                : tier === "silver" || tier === "bronze"
                  ? "grid-cols-2 md:grid-cols-4"
                  : "grid-cols-2 md:grid-cols-3 lg:grid-cols-6";
            return (
              <div class="flex flex-col gap-4">
                <span class="font-display text-[10px] uppercase tracking-pixel text-accent-yellow">
                  {sponsorTierLabels[tier]}
                </span>
                <div class:list={["grid gap-4", cols]}>
                  {tierSponsors.map((sponsor) => (
                    <Sponsor sponsor={sponsor} />
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- Sponsors CTA -->
  {
    DATA.sponsorsDossier.enabled && (
      <section id="callForSponsors">
        <SponsorsCta
          title="Haz visible tu marca en BiznagaFest"
          description="Posiciona tu empresa frente a cientos de asistentes, speakers y profesionales del ecosistema tecnológico."
          ctaHref="#sponsor-form"
          ctaLabel="Quiero patrocinar"
        />
        <div class="mx-auto max-w-[1240px] px-6 py-16 md:py-20 flex flex-col gap-8 bg-surface-page">
          <div class="flex flex-col gap-6">
            <SponsorDossier
              dossier={DATA.sponsorsDossier}
              class="mx-auto w-fit flex flex-col gap-2 items-center"
            />
            <p class="text-center font-sans text-sm text-text-primary/80">
              ¿Prefieres email?{" "}
              <a
                class="font-semibold text-accent-yellow underline underline-offset-2 hover:text-accent-blue"
                href="mailto:biznagafest@gmail.com"
                data-umami-event="sponsor_email_contact"
              >
                biznagafest@gmail.com
              </a>
            </p>
          </div>
          <div id="sponsor-form">
            <SponsorForm className="flex flex-col gap-4" client:idle />
          </div>
        </div>
      </section>
    )
  }

  <!-- Venue -->
  <section id="venue" class="bg-surface-card border-t border-border/40">
    <div
      class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-10"
    >
      <AnimatedOnViewportEnter
        animation="animate__animated animate__fadeInLeft"
      >
        <SectionHeader
          eyebrow="The Arena"
          title="Donde sucede todo"
          subtitle="BiznagaFest crece y estrena escenario: FYCMA – Palacio de Ferias y Congresos de Málaga. Más espacio, mejor acceso y una edición preparada para vivir un evento a otro nivel."
        />
      </AnimatedOnViewportEnter>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <div
          class="rounded-md overflow-hidden border border-border bg-surface-page min-h-[320px]"
        >
          <iframe
            title="Venue map"
            class="w-full h-full min-h-[320px]"
            src={DATA.venue.mapUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            width="100%"
            height="100%"></iframe>
        </div>
        <div
          class="flex flex-col gap-6 rounded-md border border-border bg-surface-page p-6 md:p-8"
        >
          <h3
            class="font-heading text-2xl md:text-3xl font-bold uppercase text-text-primary"
          >
            {DATA.venue.title}
          </h3>
          <p class="font-sans text-sm md:text-base text-text-primary/85">
            {DATA.venue.address}
          </p>
          <ul class="flex flex-col gap-4">
            {
              DATA.venue.howToArrive?.howToArriveByMetro && (
                <li class="flex items-start gap-3 font-sans text-sm text-text-primary/90">
                  <i class="ph ph-train text-xl text-accent-blue mt-0.5" />
                  <div class="flex-1 [&>ul]:list-disc [&>ul]:list-inside">
                    <RichText
                      text={DATA.venue.howToArrive.howToArriveByMetro}
                    />
                  </div>
                </li>
              )
            }
            {
              DATA.venue.howToArrive?.howToArriveByBus && (
                <li class="flex items-start gap-3 font-sans text-sm text-text-primary/90">
                  <i class="ph ph-bus text-xl text-accent-blue mt-0.5" />
                  <div class="flex-1 [&>ul]:list-disc [&>ul]:list-inside">
                    <RichText text={DATA.venue.howToArrive.howToArriveByBus} />
                  </div>
                </li>
              )
            }
            {
              DATA.venue.howToArrive?.howToArriveByBike && (
                <li class="flex items-start gap-3 font-sans text-sm text-text-primary/90">
                  <i class="ph ph-bicycle text-xl text-accent-blue mt-0.5" />
                  <div class="flex-1 [&>ul]:list-disc [&>ul]:list-inside">
                    <RichText text={DATA.venue.howToArrive.howToArriveByBike} />
                  </div>
                </li>
              )
            }
          </ul>
          <a
            href={DATA.venue.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-fit items-center gap-2 rounded-sm border border-border-highlight px-5 py-2.5 font-sans text-sm font-semibold uppercase tracking-wide text-text-primary transition-colors hover:bg-surface-card"
            data-umami-event="venue_directions_click"
          >
            <i class="ph ph-map-pin"></i>
            Cómo llegar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Previous Edition -->
  {
    (DATA.lastEdition?.lastEditionVideoUrl ||
      !!DATA.lastEdition?.gallery?.length) && (
      <section id="last" class="bg-surface-page border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-12">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Last Round"
              title="Última edición"
              subtitle="Así fue BiznagaFest 2025"
            />
          </AnimatedOnViewportEnter>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {previousEditionStats.map((stat) => (
              <StatCard value={stat.value} label={stat.label} />
            ))}
          </div>
          {!!DATA.lastEdition?.gallery?.length && (
            <Carousel
              navigation={true}
              pagination={true}
              class="w-full aspect-video rounded-md overflow-hidden border border-border"
              videoUrl={DATA.lastEdition?.lastEditionVideoUrl}
              images={DATA.lastEdition?.gallery ?? []}
            />
          )}
        </div>
      </section>
    )
  }

  <!-- Hall of Fame -->
  {
    !!DATA.hallOfFame.length && (
      <section
        id="hallOfFame"
        class="relative bg-surface-card border-t border-border/40 overflow-hidden"
      >
        <div
          aria-hidden="true"
          class="absolute inset-0 pointer-events-none opacity-50 bg-[radial-gradient(circle_at_50%_-10%,rgba(89,159,255,0.18),transparent_55%),radial-gradient(circle_at_80%_110%,rgba(234,234,0,0.08),transparent_60%)]"
        />

        <div class="relative mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-12">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="★ Hall of Fame"
              title="Han pasado por aquí"
              align="center"
            />
          </AnimatedOnViewportEnter>

          <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
            {DATA.hallOfFame.map((personality) => (
              <li class="group relative overflow-hidden rounded-md border border-border bg-surface-page aspect-square transition-all duration-300 hover:border-accent-yellow hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(234,234,0,0.22)]">
                <Image
                  src={personality.picture}
                  alt={`Image of ${personality.name}`}
                  height={400}
                  width={400}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
                  loading="lazy"
                />
                <div
                  aria-hidden="true"
                  class="absolute inset-0 bg-gradient-to-t from-surface-page via-surface-page/60 to-transparent"
                />
                <span class="absolute top-2 right-2 inline-flex items-center gap-1 rounded-sm border border-border-highlight/60 bg-surface-card/80 px-2 py-1 font-display text-[9px] tracking-pixel text-accent-yellow backdrop-blur-sm">
                  <i class="ph ph-trophy text-[10px]" aria-hidden="true" />
                  {personality.edition}
                </span>
                <div class="absolute inset-x-0 bottom-0 p-3 md:p-4">
                  <span class="block font-heading font-bold uppercase text-text-primary text-sm md:text-base leading-tight tracking-wide">
                    {personality.name}
                  </span>
                  <span class="block mt-1 h-[2px] w-8 bg-accent-yellow transition-all duration-300 group-hover:w-16" />
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Call for Papers -->
  {
    DATA.callForPapers.isEnabled && (
      <section
        id="cfp"
        class="bg-surface-page border-t border-border/40 py-12 md:py-16 grid place-items-center"
      >
        <a
          aria-label="Call for Papers Link"
          class="inline-flex items-center gap-2 rounded-sm bg-action-secondary px-6 py-3 font-display text-xs uppercase tracking-pixel text-white transition-colors hover:bg-action-secondary-hover animate-pulse"
          href={DATA.callForPapers.url}
          target="_blank"
          data-umami-event="call_for_papers_click"
        >
          ▸ {DATA.callForPapers.title}
        </a>
      </section>
    )
  }

  <!-- FAQ -->
  {
    !!DATA.faq.length && (
      <section id="faq" class="bg-surface-card border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-10">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Pause Menu"
              title="Preguntas frecuentes"
              align="center"
            />
          </AnimatedOnViewportEnter>
          <Accordion data={DATA.faq} />
        </div>
      </section>
    )
  }

  <!-- Team / Organizers -->
  {
    !!DATA.team.organizers.length && (
      <section id="team" class="bg-surface-page border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-10">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Crew"
              title="Equipo"
              subtitle="Las personas que organizan BiznagaFest."
            />
          </AnimatedOnViewportEnter>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            {DATA.team.organizers.map((member, index) => (
              <TeamMember kind="organizer" member={member} index={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Staff -->
  {
    !!DATA.team.staff.length && (
      <section id="staff" class="bg-surface-card border-t border-border/40">
        <div class="mx-auto max-w-[1240px] px-6 py-20 md:py-24 flex flex-col gap-10">
          <AnimatedOnViewportEnter animation="animate__animated animate__fadeInLeft">
            <SectionHeader
              eyebrow="Squad"
              title="Voluntarios"
              subtitle="El equipo de soporte que hace posible cada edición."
            />
          </AnimatedOnViewportEnter>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
            {DATA.team.staff.map((member, index) => (
              <TeamMember kind="staff" member={member} index={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
