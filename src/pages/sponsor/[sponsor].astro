---
import { Image } from "astro:assets";
import JobOfferCard from "../../components/JobOfferCard.astro";
import RichText from "../../components/RichText.astro";
import Socials from "../../components/Socials.astro";
import Layout from "../../layouts/Layout.astro";
import {
  buildBreadcrumbJsonLd,
  buildOrganizationJsonLd,
} from "../../utils/json-ld";

const { data } = Astro.locals;
const { sponsor } = Astro.params;

const sponsorData = data.sponsors.find((s) => s.name === sponsor);

if (!sponsorData || sponsorData.hasFeaturedPage === false) {
  return Astro.rewrite("/404");
}

const baseUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, baseUrl);
const jsonLd = [
  buildOrganizationJsonLd(sponsorData, pageUrl, baseUrl),
  buildBreadcrumbJsonLd([
    { name: "Inicio", url: new URL("/", baseUrl) },
    { name: "Sponsors", url: new URL("/#sponsors", baseUrl) },
    { name: sponsorData.name, url: pageUrl },
  ]),
];
---

<Layout
  title={`${sponsorData.name} | ${data.title}`}
  description={sponsorData.description}
  image={sponsorData.picture}
  ogType="article"
  jsonLd={jsonLd}
  lang="es"
>
  <main class="flex flex-col gap-10 min-h-screen mx-auto max-w-[1240px] px-6 py-16 md:py-24">
    <header
      class="rounded-md border border-border bg-surface-card p-8 md:p-12"
    >
      <Image
        transition:name={sponsorData.name}
        class="mx-auto w-full h-full object-contain max-h-[300px]"
        src={sponsorData.picture}
        alt={sponsorData.name}
        height={400}
        width={400}
      />
    </header>
    {
      !!sponsorData.description !== undefined && (
        <div class="md:w-10/12 md:mx-auto flex flex-col gap-4 font-sans text-base md:text-lg text-text-primary/90 leading-relaxed">
          <RichText text={sponsorData.description} />
        </div>
      )
    }
    <div class="mx-auto">
      <Socials
        socials={sponsorData.socials}
        class="text-3xl text-text-primary hover:text-accent-yellow transition-colors"
      />
    </div>
    {
      !!sponsorData.jobOffers.length && (
        <section class="flex flex-col gap-6">
          <h3 class="font-heading text-3xl font-bold uppercase text-text-primary text-center">
            Ofertas de trabajo
          </h3>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {sponsorData.jobOffers.map((jobOffer) => (
              <JobOfferCard jobOffer={jobOffer} />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
