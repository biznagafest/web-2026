---
import { type Ticket } from "../data/data.type";
import TicketItem from "../components/TicketItem.astro";
interface Props {
  tickets: ReadonlyArray<Ticket>;
}

const { tickets } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto w-full">
  {
    tickets.map((ticket) => (
      <TicketItem ticket={ticket} featured={!!ticket.isFeatured} />
    ))
  }
</div>
