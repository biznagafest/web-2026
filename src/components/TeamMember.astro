---
import { Image } from "astro:assets";
import type { TeamMember } from "../data/data.type";
interface Props {
  member: TeamMember;
  kind: "organizer" | "staff";
  index: number;
}

const { member, index, kind } = Astro.props;
---

<a
  aria-label={`Go to ${member.name}'s profile`}
  href={`/${kind}/${index}`}
  data-umami-event="team_member_profile_click"
  class="flex flex-col rounded-md border border-border bg-surface-card overflow-hidden shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-border-highlight"
>
  <div
    transition:name={`picture-${kind}-${member.name}`}
    class="relative aspect-[260/180] w-full overflow-hidden bg-surface-page"
  >
    <Image
      src={member.picture}
      alt={`Picture of ${member.name}`}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500"
      style="-webkit-user-drag: none;"
      height={180}
      width={260}
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-card/5 to-surface-card pointer-events-none"
      aria-hidden="true"
    >
    </div>
  </div>
  <div class="flex flex-col px-3 py-3">
    <h3
      transition:name={`name-${kind}-${member.name}`}
      class="font-heading text-lg font-bold tracking-wide text-text-primary leading-tight truncate"
    >
      {member.name}
    </h3>
  </div>
</a>
