---
import { type Ticket } from "../data/data.type";

interface Props {
  ticket: Ticket;
  featured?: boolean;
}

const { ticket, featured = false } = Astro.props;
const isSoldOut = !!ticket.isSoldOut;
const tierLabel = ticket.subtitle ?? "";
---

{
  featured ? (
    <div class="ticket-featured-border rounded-md p-[2px] shadow-[0_4px_16px_rgba(0,0,0,0.45)] transition-transform duration-300 hover:-translate-y-1">
      <article
        class:list={[
          "flex flex-col rounded-[6px] bg-surface-card overflow-hidden h-full",
          isSoldOut && "opacity-60",
        ]}
      >
        <header class="flex flex-col gap-2 px-6 py-4 bg-accent-red/[0.07]">
          {tierLabel && (
            <span class="font-sans text-[11px] font-semibold uppercase tracking-[0.11em] text-accent-red/90">
              {tierLabel}
            </span>
          )}
          <h3 class="font-heading text-xl font-bold text-text-primary tracking-wide leading-tight">
            {ticket.name}
          </h3>
        </header>

        <div class="flex flex-col gap-[2px] px-6 pt-4 pb-3">
          <span class="font-sans text-[11px] text-text-secondary/55">
            Precio
          </span>
          {isSoldOut ? (
            <span class="font-heading text-5xl font-bold text-accent-red leading-none">
              SOLD OUT
            </span>
          ) : (
            <span class="font-heading text-[56px] font-bold leading-none bg-gradient-to-r from-accent-yellow to-accent-red bg-clip-text text-transparent">
              {ticket.price}€
            </span>
          )}
        </div>

        <div class="px-5">
          <div class="h-px bg-text-primary/10" />
        </div>

        <ul class="flex flex-col gap-[10px] px-6 pt-4 pb-2">
          {ticket.perks.map((perk) => (
            <li class="flex items-center gap-[10px]">
              <span
                aria-hidden="true"
                class="shrink-0 w-[5px] h-[5px] rounded-full bg-text-primary/75"
              />
              <span class="font-sans text-[13px] leading-tight text-text-primary/75">
                {perk}
              </span>
            </li>
          ))}
        </ul>

        {ticket.notice && (
          <div class="px-6 pt-4 pb-3">
            <p class="font-sans text-[11px] text-text-secondary leading-snug">
              {ticket.notice}
            </p>
          </div>
        )}

        <div class="mt-auto px-6 pt-3 pb-5">
          {!isSoldOut && (
            <a
              href={ticket.url}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="ticket_purchase_click"
              class="pretix-buy-button flex w-full items-center justify-center rounded-md bg-action-primary px-6 py-3 font-sans text-sm font-semibold tracking-[0.01em] text-white transition-colors hover:bg-action-primary-hover"
            >
              Comprar entrada
            </a>
          )}
        </div>
      </article>
    </div>
  ) : (
    <article
      class:list={[
        "flex flex-col rounded-md border border-border bg-surface-card overflow-hidden shadow-[0_4px_16px_rgba(0,0,0,0.45)] transition-transform duration-300 hover:-translate-y-1",
        isSoldOut && "opacity-60",
      ]}
    >
      <header class="flex flex-col gap-2 px-6 py-4 bg-action-secondary/[0.08]">
        {tierLabel && (
          <span class="font-sans text-[11px] font-semibold uppercase tracking-[0.11em] text-text-secondary/65">
            {tierLabel}
          </span>
        )}
        <h3 class="font-heading text-xl font-bold text-text-primary tracking-wide leading-tight">
          {ticket.name}
        </h3>
      </header>

      <div class="flex flex-col gap-[2px] px-6 pt-4 pb-3">
        <span class="font-sans text-[11px] text-text-secondary/55">Precio</span>
        {isSoldOut ? (
          <span class="font-heading text-5xl font-bold text-accent-red leading-none">
            SOLD OUT
          </span>
        ) : (
          <span class="font-heading text-[56px] font-bold text-text-primary leading-none">
            {ticket.price}€
          </span>
        )}
      </div>

      <div class="px-5">
        <div class="h-px bg-text-primary/10" />
      </div>

      <ul class="flex flex-col gap-[10px] px-6 pt-4 pb-2">
        {ticket.perks.map((perk) => (
          <li class="flex items-center gap-[10px]">
            <span
              aria-hidden="true"
              class="shrink-0 w-[5px] h-[5px] rounded-full bg-text-primary/75"
            />
            <span class="font-sans text-[13px] leading-tight text-text-primary/75">
              {perk}
            </span>
          </li>
        ))}
      </ul>

      {ticket.notice && (
        <div class="px-6 pt-4 pb-3">
          <p class="font-sans text-[11px] text-text-secondary leading-snug">
            {ticket.notice}
          </p>
        </div>
      )}

      <div class="mt-auto px-6 pt-3 pb-5">
        {!isSoldOut && (
          <a
            href={ticket.url}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="ticket_purchase_click"
            class="pretix-buy-button flex w-full items-center justify-center rounded-md bg-action-secondary px-6 py-3 font-sans text-sm font-semibold tracking-[0.01em] text-white transition-colors hover:bg-action-secondary-hover"
          >
            Comprar entrada
          </a>
        )}
      </div>
    </article>
  )
}

<style>
  .ticket-featured-border {
    background-image: repeating-linear-gradient(
      90deg,
      #eaea00 0%,
      #de1223 25%,
      #eaea00 50%,
      #de1223 75%,
      #eaea00 100%
    );
    background-size: 300% 100%;
    background-position: 0% 50%;
    animation: ticket-border-flow 10s linear infinite;
  }

  @keyframes ticket-border-flow {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 300% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket-featured-border {
      animation: none;
    }
  }
</style>
