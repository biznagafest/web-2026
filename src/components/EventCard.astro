---
import type { Event } from "../data/data.type";
import type { Nullish } from "../utils/nullish";
import RichText from "./RichText.astro";
interface Props {
  event: Event;
}

const { event } = Astro.props;

function formatDate(date?: Nullish<string>) {
  if (!date) {
    return;
  }

  const richDate = new Date(date);

  return Intl.DateTimeFormat("es-ES", {
    timeStyle: "short",
  }).format(richDate);
}
---

<article
  class="flex flex-col rounded-md border border-border bg-surface-card p-5 md:p-6 gap-5 w-full"
>
  <header class="flex flex-col gap-4">
    <div
      class="flex flex-wrap flex-row gap-2 justify-center md:justify-start border-b border-border pb-4 text-xs"
    >
      <span
        class="rounded-full bg-accent-red px-3 py-1 font-display text-[10px] uppercase tracking-pixel text-white"
      >
        {event.type === "lecture" ? "Charla" : "Taller"}
      </span>
      {
        event.date && (
          <span class="rounded-full bg-accent-yellow text-text-inverse px-3 py-1 font-display text-[10px] tracking-pixel flex items-center gap-1">
            <i class="ph ph-clock" />
            {formatDate(event.date)}
          </span>
        )
      }

      {
        event.place && (
          <span class="rounded-full bg-action-secondary text-white px-3 py-1 font-display text-[10px] tracking-pixel">
            {event.place}
          </span>
        )
      }
      {
        event.durationInMinutes && (
          <span class="rounded-full bg-action-secondary text-white px-3 py-1 font-display text-[10px] tracking-pixel">
            {event.durationInMinutes} min
          </span>
        )
      }
      {
        event.language && (
          <span class="rounded-full bg-action-secondary text-white px-3 py-1 font-display text-[10px] tracking-pixel">
            {event.language}
          </span>
        )
      }
    </div>
    <h3
      class="font-heading text-2xl font-bold uppercase text-text-primary"
    >
      {event.name}
    </h3>
  </header>
  <div
    class="flex flex-col gap-3 font-sans text-base text-text-primary/85 leading-relaxed"
  >
    <RichText text={event.description} />
  </div>
</article>
