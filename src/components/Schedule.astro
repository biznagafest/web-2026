---
import type { ScheduleItem } from "../data/data.type";
import RichText from "./RichText.astro";

interface Props {
  data: ReadonlyArray<ScheduleItem>;
}

const { data } = Astro.props;

type Variant = "lecture" | "workshop" | "break";

function variantOf(item: ScheduleItem): Variant {
  if (item.kind === "break") return "break";
  return item.type === "workshop" ? "workshop" : "lecture";
}

const variantStyles: Record<
  Variant,
  {
    accentBar: string;
    cardBg: string;
    typeTagBg: string;
    typeTagText: string;
    typeLabel: string;
  }
> = {
  lecture: {
    accentBar: "bg-accent-red",
    cardBg: "bg-surface-card",
    typeTagBg: "bg-accent-red",
    typeTagText: "text-white",
    typeLabel: "CHARLA",
  },
  workshop: {
    accentBar: "bg-accent-blue",
    cardBg: "bg-surface-card",
    typeTagBg: "bg-accent-blue",
    typeTagText: "text-text-inverse",
    typeLabel: "TALLER",
  },
  break: {
    accentBar: "bg-accent-yellow",
    cardBg: "bg-surface-page",
    typeTagBg: "bg-accent-yellow",
    typeTagText: "text-text-inverse",
    typeLabel: "BREAK",
  },
};

type Round = { key: string; label: string; items: ScheduleItem[] };

const groups: Round[] = [];
let roundIndex = 1;
let currentRound: Round = {
  key: `round-${roundIndex}`,
  label: `ROUND ${roundIndex}`,
  items: [],
};
groups.push(currentRound);

for (const item of data) {
  if (item.kind === "half-divider") {
    roundIndex += 1;
    currentRound = {
      key: `round-${roundIndex}`,
      label: `ROUND ${roundIndex}`,
      items: [],
    };
    groups.push(currentRound);
    continue;
  }
  currentRound.items.push(item);
}

const renderedGroups = groups
  .filter((g) => g.items.length > 0)
  .map((g, i) => ({ ...g, key: `round-${i + 1}`, label: `ROUND ${i + 1}` }));
---

<div class="flex flex-col gap-10">
  {
    renderedGroups.map((group) => (
      <section class="flex flex-col gap-6">
        <header class="flex items-center justify-center gap-6 h-10">
          <span
            aria-hidden="true"
            class="flex-1 h-[3px] rounded-sm bg-gradient-to-r from-accent-yellow to-accent-red shadow-[inset_0_1px_0_rgba(89,159,255,0.2)]"
          />
          <span class="font-display text-sm md:text-base text-text-primary whitespace-nowrap">
            {group.label}
          </span>
          <span
            aria-hidden="true"
            class="flex-1 h-[3px] rounded-sm bg-gradient-to-l from-accent-yellow to-accent-red shadow-[inset_0_1px_0_rgba(89,159,255,0.2)]"
          />
        </header>

        <ul class="flex flex-col gap-4">
          {group.items.map((item) => {
            const v = variantOf(item);
            const styles = variantStyles[v];
            const isBreak = v === "break";
            const isInteractive = !!item.description;
            return (
              <li
                class:list={[
                  "schedule-item flex flex-row items-stretch overflow-hidden border border-border rounded-l-sm rounded-r-md transition-colors",
                  styles.cardBg,
                  isInteractive && "cursor-pointer hover:border-border-highlight",
                ]}
              >
                <span
                  aria-hidden="true"
                  class:list={["shrink-0 w-1 rounded-l-md", styles.accentBar]}
                />
                <div class="flex flex-col items-center justify-center gap-1 shrink-0 w-16 md:w-20 bg-[rgba(3,3,138,0.15)] px-3 text-text-primary text-center">
                  <span class="font-sans text-[13px] font-semibold leading-none">
                    {item.start}
                  </span>
                  {item.end && item.end !== item.start && (
                    <span class="font-sans text-[13px] font-normal leading-none text-text-primary/80">
                      {item.end}
                    </span>
                  )}
                </div>
                <span
                  aria-hidden="true"
                  class="shrink-0 w-px self-stretch bg-surface-contrast/10"
                />
                <div class="flex-1 min-w-0 flex flex-col gap-3 px-5 py-4 md:px-6">
                  <div class="schedule-meta flex flex-wrap items-center gap-2">
                    <span
                      class:list={[
                        "inline-flex items-center justify-center rounded-full px-3 py-1 font-sans text-[9px] font-semibold tracking-[0.09em] whitespace-nowrap",
                        styles.typeTagBg,
                        styles.typeTagText,
                      ]}
                    >
                      {styles.typeLabel}
                    </span>
                    {item.language && !isBreak && (
                      <span class="inline-flex items-center justify-center rounded-full border border-border px-3 py-1 font-sans text-[9px] font-semibold tracking-[0.09em] text-text-primary whitespace-nowrap">
                        {item.language === "Español"
                          ? "ES"
                          : item.language === "English"
                            ? "EN"
                            : item.language}
                      </span>
                    )}
                    {item.topic && !isBreak && (
                      <span class="inline-flex items-center justify-center rounded-full border border-border px-3 py-1 font-sans text-[9px] font-semibold tracking-[0.09em] text-text-primary whitespace-nowrap">
                        {item.topic}
                      </span>
                    )}
                    {item.location && (
                      <span class="inline-flex items-center justify-center rounded-full border border-border px-3 py-1 font-sans text-[9px] font-semibold tracking-[0.09em] text-text-primary whitespace-nowrap">
                        {item.location}
                      </span>
                    )}
                    {isInteractive && (
                      <i class="ph ph-caret-down ml-auto text-text-secondary transition-transform duration-200" />
                    )}
                  </div>
                  <div class="flex flex-col gap-1">
                    <p class="font-heading text-base md:text-lg font-bold text-text-primary leading-snug tracking-wide">
                      {item.title}
                    </p>
                    {item.subtitle && !isBreak && (
                      <p class="font-sans text-[13px] text-text-secondary leading-tight">
                        {item.subtitle}
                      </p>
                    )}
                  </div>
                  {item.description && (
                    <div class="schedule-body hidden font-sans text-sm text-text-primary/85 leading-relaxed">
                      <RichText text={item.description} />
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

<script is:inline data-astro-rerun>
  (() => {
    const items = document.querySelectorAll(".schedule-item");

    items.forEach((item) => {
      const body = item.querySelector(".schedule-body");
      if (!body) return;

      item.addEventListener("click", () => {
        const isActive = item.classList.toggle("active");
        body.classList.toggle("hidden", !isActive);
        item.querySelector(".ph-caret-down")?.classList.toggle("rotate-180", isActive);

        items.forEach((other) => {
          if (other !== item) {
            other.classList.remove("active");
            other.querySelector(".schedule-body")?.classList.add("hidden");
            other.querySelector(".ph-caret-down")?.classList.remove("rotate-180");
          }
        });
      });
    });
  })();
</script>
