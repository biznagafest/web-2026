---
// Toggles animation classes on elements with `.animate` and a
// `data-animation` attribute as they enter/leave the viewport.
// Re-binds on every client-side navigation (ClientRouter) and cleans
// up the previous observer to avoid leaks.
---

<script>
  let observer: IntersectionObserver | null = null;

  function attach(): void {
    detach();
    const targets = document.querySelectorAll<HTMLElement>(".animate");
    if (!targets.length) return;

    observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          const classes = (target.dataset.animation ?? "")
            .split(" ")
            .filter(Boolean);

          if (entry.isIntersecting) {
            if (
              !target.dataset.animationRepeat &&
              target.dataset.animationRepeated
            ) {
              obs.unobserve(target);
              continue;
            }
            target.dataset.animationRepeated = "true";
            for (const cls of classes) target.classList.add(cls);
            target.classList.remove("invisible");
          } else if (entry.boundingClientRect.top > 0) {
            for (const cls of classes) target.classList.remove(cls);
          }
        }
      },
      { rootMargin: "200px 0px" },
    );

    for (const target of targets) observer.observe(target);
  }

  function detach(): void {
    observer?.disconnect();
    observer = null;
  }

  attach();
  document.addEventListener("astro:page-load", attach);
  document.addEventListener("astro:before-swap", detach);
</script>
