---
import { Image } from "astro:assets";
import type { Host } from "../data/data.type";
import { slugify } from "../utils/slug";
interface Props {
  host: Host;
}

const { host } = Astro.props;
const slug = slugify(host.name);
---

<a
  aria-label={`Go to ${host.name}'s profile`}
  href={`/host/${slug}`}
  data-astro-history="push"
  data-umami-event="host_profile_click"
  class="flex flex-col rounded-md border border-border bg-surface-card overflow-hidden shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-border-highlight"
>
  <div
    transition:name={`picture-host-${slug}`}
    class="relative aspect-[260/180] w-full overflow-hidden bg-surface-page"
  >
    <Image
      src={host.picture}
      alt={`Picture of ${host.name}`}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500"
      style="-webkit-user-drag: none;"
      height={180}
      width={260}
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-card/5 to-surface-card pointer-events-none"
      aria-hidden="true"
    >
    </div>
  </div>
  <div class="flex flex-col gap-[3px] px-3 py-3">
    <h3
      transition:name={`name-host-${slug}`}
      class="font-heading text-lg font-bold tracking-wide text-text-primary leading-tight truncate"
    >
      {host.name}
    </h3>
    {
      host.position && (
        <span class="font-sans text-[11px] text-text-secondary/80 truncate">
          {host.position}
        </span>
      )
    }
  </div>
</a>
