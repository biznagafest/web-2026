---
import { ClientRouter } from "astro:transitions";
import { DATA } from "../data/data";

interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  image = "/BIZNAGAFEST-2026-OPENGRAPH.webp",
  description,
  title,
  noIndex = false,
  jsonLd,
} = Astro.props;

const siteName = DATA.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = new URL(image, Astro.site ?? Astro.url).toString();

const ticketsUrl = DATA.ticketsUrl?.trim();
let pretixOrigin: string | null = null;
let pretixCssHref: string | null = null;
let pretixJsHref: string | null = null;
if (ticketsUrl) {
  try {
    const parsed = new URL(ticketsUrl);
    pretixOrigin = parsed.origin;
    const base = ticketsUrl.endsWith("/") ? ticketsUrl : `${ticketsUrl}/`;
    pretixCssHref = `${base}widget/v2.css`;
    pretixJsHref = `${parsed.origin}/widget/v2.en.js`;
  } catch {
    // ticketsUrl is not a valid absolute URL — skip widget tags
  }
}
---

<head>
  <ClientRouter />
  <!--
    Defensive history sync: ClientRouter occasionally completes the DOM swap without
    calling history.pushState (race conditions between aborted in-flight navigations and
    view transition timing). If after a swap the URL doesn't match the target captured at
    before-preparation, we push it manually so the browser back button stays consistent.
  -->
  <script is:inline>
    (() => {
      let pendingTarget = null;
      document.addEventListener("astro:before-preparation", (e) => {
        if (e && e.to && e.navigationType !== "traverse") {
          pendingTarget = e.to.href;
        } else {
          pendingTarget = null;
        }
      });
      document.addEventListener("astro:after-swap", () => {
        const target = pendingTarget;
        pendingTarget = null;
        if (!target) return;
        if (location.href !== target) {
          try {
            history.pushState(history.state || {}, "", target);
          } catch {}
        }
      });
    })();
  </script>
  <!--
    Umami's auto-track click handler on data-umami-event anchors calls preventDefault()
    and then hard-reloads via location.href, which breaks ClientRouter SPA navigation.
    We disable Umami auto-track (data-auto-track="false") and replicate the parts we
    need manually — pageview on initial load + on every astro:after-swap, and a click
    listener that calls umami.track() without preventing navigation.
  -->
  <script is:inline>
    (() => {
      function extractEventData(el) {
        const data = {};
        for (const attr of el.attributes) {
          const m = attr.name.match(/^data-umami-event-(.+)$/);
          if (m) data[m[1]] = attr.value;
        }
        return data;
      }
      document.addEventListener("click", (e) => {
        const target =
          e.target instanceof Element
            ? e.target.closest("[data-umami-event]")
            : null;
        if (!target) return;
        const name = target.getAttribute("data-umami-event");
        if (!name) return;
        if (window.umami && typeof window.umami.track === "function") {
          try {
            window.umami.track(name, extractEventData(target));
          } catch {}
        }
      });
      function trackPageview() {
        if (window.umami && typeof window.umami.track === "function") {
          try {
            window.umami.track();
          } catch {}
        }
      }
      document.addEventListener("astro:page-load", trackPageview);
    })();
  </script>
  <!-- Animate.css CDN -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />

  <!-- Phosphor icons CDN -->
  <link
    rel="stylesheet"
    type="text/css"
    href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
  />

  <!-- Fonts: self-hosted Inter / Rajdhani / Press Start 2P -->
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    crossorigin
    href="/fonts/Inter/Inter-400-latin.woff2"
  />
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    crossorigin
    href="/fonts/Rajdhani/Rajdhani-700-latin.woff2"
  />
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    crossorigin
    href="/fonts/PressStart2P/PressStart2P-400-latin.woff2"
  />

  {
    pretixOrigin && (
      <>
        <link rel="preconnect" href={pretixOrigin} crossorigin />
        <link
          rel="stylesheet"
          type="text/css"
          href={pretixCssHref}
          crossorigin
        />
        <script
          type="text/javascript"
          src={pretixJsHref}
          async
          crossorigin="anonymous"
        />
        <style>
          {`@media (max-width: 480px) {
            .pretix-widget-frame-inner,
            .pretix-widget-lightbox-inner,
            .pretix-widget-alert-box {
              height: 100dvh;
            }
          }`}
        </style>
      </>
    )
  }

  <!-- Global Metadata -->
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1,viewport-fit=cover"
  />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#000046" />
  <meta name="color-scheme" content="dark" />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="mask-icon" href="/favicon.svg" color="#000046" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <link
    rel="alternate"
    type="application/rss+xml"
    title="RSS"
    href="/rss.xml"
  />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Robots -->
  {
    noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )
  }

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta
    name="keywords"
    content="BiznagaFest, BiznagaFest 2026, GDG Málaga, Google Developers, tech festival, conferencia tecnología, Málaga, Costa del Sol, DevFest, IT, desarrollo, software, IA, devops, frontend, backend"
  />
  <meta name="author" content="GDG Málaga" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:secure_url" content={imageURL} />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="628" />
  <meta property="og:image:alt" content={`${siteName} — Are you ready?`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
  <meta name="twitter:image:alt" content={`${siteName} — Are you ready?`} />

  {
    jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )
  }
