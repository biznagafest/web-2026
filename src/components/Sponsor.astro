---
import type { Sponsor, SponsorTier } from "../data/data.type";
import { slugify } from "../utils/slug";

interface Props {
  sponsor: Sponsor;
}

const { sponsor } = Astro.props;

const tierHeights: Record<SponsorTier, string> = {
  platinum: "h-20 md:h-24",
  gold: "h-20 md:h-24",
  silver: "h-16 md:h-20",
  bronze: "h-14 md:h-16",
  communitySponsor: "h-14 md:h-16",
  media: "h-12 md:h-14",
  food: "h-12 md:h-14",
  community: "h-12 md:h-14",
  supporter: "h-12 md:h-14",
};

const tierPaddings: Record<SponsorTier, string> = {
  platinum: "px4 py-3",
  gold: "px-4 py-3",
  silver: "px-3 py-2",
  bronze: "px-3 py-2",
  communitySponsor: "px-3 py-2",
  media: "px-2 py-1",
  food: "px-2 py-1",
  community: "px-2 py-1",
  supporter: "px-2 py-1",
};

const cardHeight = tierHeights[sponsor.tier];
const cardPadding = tierPaddings[sponsor.tier];
---

<a
  aria-label={`Visita la web de ${sponsor.name}`}
  href={sponsor.hasFeaturedPage ? `/sponsor/${slugify(sponsor.name)}` : sponsor.url}
  data-umami-event="sponsor_link_click"
  target={sponsor.hasFeaturedPage ? undefined : "_blank"}
  rel={sponsor.hasFeaturedPage ? undefined : "noopener noreferrer"}
  class="group flex items-center justify-center rounded-md border border-border bg-surface-card/60 p-3 transition-all duration-300 hover:border-border-highlight w-full"
>
  <span
    class:list={["flex w-full items-center justify-center rounded-sm bg-[#f4f5fb] transition-colors duration-300 group-hover:bg-white", cardPadding]}
  >
    <img
      src={sponsor.picture}
      alt={`Logo de ${sponsor.name}`}
      loading="lazy"
      decoding="async"
      class:list={[
        "w-auto max-w-full object-contain",
        cardHeight,
      ]}
    />
  </span>
</a>
