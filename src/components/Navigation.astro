---
import { Image } from "astro:assets";
import { DATA } from "../data/data";
import PretixBuyButton from "./PretixBuyButton.astro";

const featuredSponsors = DATA.sponsors.filter(
  (sponsor) => sponsor.tier === "gold" && sponsor.hasFeaturedPage,
);
---

<nav
  id="top"
  class="sticky top-0 z-30 w-full bg-surface-page/95 backdrop-blur supports-[backdrop-filter]:bg-surface-page/80 border-b border-border"
>
  <div
    class="mx-auto max-w-[1240px] flex flex-col sm:flex-row items-center justify-between gap-4 px-6 py-4"
  >
    <div class="flex items-center justify-between w-full sm:w-auto">
      <a
        aria-label="Go to Home Page"
        href="/"
        data-umami-event="nav_logo_click"
        class="flex items-center gap-3"
      >
        <Image
          src="/logo.svg"
          alt={`Logo of ${DATA.title}`}
          class="invert h-10 w-auto"
          height="40"
          width="180"
          loading="eager"
        />
      </a>
      <button
        id="menu-button"
        class="xl:hidden text-text-primary p-2"
        data-umami-event="menu_toggle_click"
        aria-label="Abrir menú"
      >
        <i class="ph ph-list text-2xl"></i>
      </button>
    </div>

    <div
      id="menu"
      class="w-full xl:w-auto max-xl:fixed max-xl:top-0 max-xl:right-0 max-xl:z-40 max-xl:h-full max-xl:w-3/4 max-xl:max-w-sm max-xl:p-6 max-xl:overflow-y-auto max-xl:translate-x-full max-xl:bg-surface-card max-xl:border-l max-xl:border-border transition-transform duration-300"
      tabindex="-1"
    >
      <ul
        class="flex xl:flex-row flex-col xl:items-center gap-2 xl:gap-1 max-xl:mt-16 font-sans text-sm font-medium"
      >
        {
          !!DATA.schedule.length && (
            <li>
              <a
                aria-label="Go to Schedule"
                href="/#schedule"
                data-umami-event="nav_schedule_click"
                class="block px-3 py-2 rounded-sm text-text-primary hover:text-accent-yellow hover:bg-surface-card transition-colors"
              >
                Agenda
              </a>
            </li>
          )
        }
        {
          !!DATA.speakers.length && (
            <li>
              <a
                aria-label="Go to Speakers"
                href="/#speakers"
                data-umami-event="nav_speakers_click"
                class="block px-3 py-2 rounded-sm text-text-primary hover:text-accent-yellow hover:bg-surface-card transition-colors"
              >
                Speakers
              </a>
            </li>
          )
        }
        {
          !!DATA.tickets.length && (
            <li>
              <a
                aria-label="Go to Tickets"
                href="/#tickets"
                data-umami-event="nav_tickets_click"
                class="block px-3 py-2 rounded-sm text-text-primary hover:text-accent-yellow hover:bg-surface-card transition-colors"
              >
                Entradas
              </a>
            </li>
          )
        }
        {
          !!DATA.sponsors.length && (
            <li>
              <a
                aria-label="Go to Sponsors"
                href="/#sponsors"
                data-umami-event="nav_sponsors_click"
                class="block px-3 py-2 rounded-sm text-text-primary hover:text-accent-yellow hover:bg-surface-card transition-colors"
              >
                Sponsors
              </a>
            </li>
          )
        }
        {
          !!DATA.raffles.length && (
            <li>
              <a
                aria-label="Go to Raffles Page"
                href="/raffles"
                data-umami-event="nav_raffles_click"
                class="block px-3 py-2 rounded-sm text-text-primary hover:text-accent-yellow hover:bg-surface-card transition-colors"
              >
                Sorteos
              </a>
            </li>
          )
        }
        {
          !!DATA.faq.length && (
            <li>
              <a
                aria-label="Go to FAQ"
                href="/#faq"
                data-umami-event="nav_faq_click"
                class="block px-3 py-2 rounded-sm text-text-primary hover:text-accent-yellow hover:bg-surface-card transition-colors"
              >
                FAQ
              </a>
            </li>
          )
        }
        {
          !!DATA.sponsorsDossier.enabled && (
            <li class="xl:ml-2">
              <a
                aria-label="Go to Sponsors Dossier"
                href="/#callForSponsors"
                data-umami-event="sponsor_cta_click"
                class="block px-3 py-2 rounded-sm font-display text-[10px] uppercase tracking-pixel text-accent-yellow hover:text-white transition-colors"
              >
                Patrocina
              </a>
            </li>
          )
        }
        {
          featuredSponsors.map((sponsor) => (
            <li>
              <a
                aria-label={`Go to ${sponsor.name} Page`}
                href={`/sponsor/${encodeURIComponent(sponsor.name)}`}
                data-umami-event="nav_sponsor_click"
                class="block px-3 py-2 rounded-sm text-text-secondary hover:text-accent-yellow transition-colors"
              >
                Meet {sponsor.name}
              </a>
            </li>
          ))
        }
        <li class="xl:ml-3">
          <PretixBuyButton
            class="w-full xl:w-auto inline-flex items-center justify-center px-4 py-2 rounded-sm bg-action-primary text-white font-sans text-xs font-semibold uppercase tracking-wide hover:bg-action-primary-hover transition-colors"
          />
        </li>
      </ul>
    </div>
  </div>
</nav>
<div
  id="drawer-menu-backdrop"
  aria-hidden="true"
  class="hidden bg-black/70 fixed inset-0 z-30"
>
</div>
<script is:inline data-astro-rerun>
  (() => {
    function isMenuOpen(button) {
      return !!button.attributes.getNamedItem("expanded");
    }

    function openMenu(button, menu, backdrop) {
      backdrop?.classList.remove("hidden");

      menu?.classList.remove("max-xl:translate-x-full");
      menu?.setAttribute("aria-modal", "true");
      menu?.setAttribute("role", "dialog");

      button.innerHTML = `<i class="ph ph-x text-2xl"></i>`;
      button.setAttribute("expanded", "true");
      button.setAttribute("aria-label", "Cerrar menú");
      if (window.innerWidth <= 1280) {
        document.body.classList.add("overflow-hidden");
      }
    }

    function closeMenu(button, menu, backdrop) {
      backdrop?.classList.add("hidden");

      menu?.classList.add("max-xl:translate-x-full");
      menu?.removeAttribute("aria-modal");
      menu?.removeAttribute("role");

      button.removeAttribute("expanded");
      button.innerHTML = `<i class="ph ph-list text-2xl"></i>`;
      button.setAttribute("aria-label", "Abrir menú");

      if (window.innerWidth <= 1280) {
        document.body.classList.remove("overflow-hidden");
      }
    }

    function toggleMenu(button, menu, backdrop) {
      if (isMenuOpen(button)) {
        closeMenu(button, menu, backdrop);
      } else {
        openMenu(button, menu, backdrop);
      }
    }

    const button = document.querySelector("#menu-button");
    const menu = document.querySelector("#menu");
    const backdrop = document.querySelector("#drawer-menu-backdrop");
    if (!menu || !button || !backdrop) return;

    button.addEventListener("click", () => {
      toggleMenu(button, menu, backdrop);
    });

    document.querySelectorAll("nav ul > li > a").forEach((elem) =>
      elem.addEventListener("click", () => {
        closeMenu(button, menu, backdrop);
      }),
    );

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1280 && isMenuOpen(button)) {
        closeMenu(button, menu, backdrop);
      }
    });

    backdrop.addEventListener("click", () => closeMenu(button, menu, backdrop));
  })();
</script>
