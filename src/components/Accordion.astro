---
import type { FAQ } from "../data/data.type";
import RichText from "./RichText.astro";

interface Props {
  data: ReadonlyArray<FAQ>;
}

const { data } = Astro.props;
---

<ul
  class="accordion flex flex-col gap-3 w-full [&_a]:text-accent-yellow [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-accent-blue"
>
  {
    data.map((faq: FAQ) => (
      <li class:list={["accordion-item flex flex-col rounded-md border border-border bg-surface-card overflow-hidden transition-colors hover:border-border-highlight"]}>
        <header
          class="accordion-header flex flex-row items-center justify-between gap-3 cursor-pointer px-6 py-4 select-none transition-colors"
          data-umami-event="faq_item_toggle"
        >
          <span class="accordion-title font-heading text-base md:text-lg font-bold text-text-primary tracking-wide transition-colors">
            {faq.title}
          </span>
          <span class="accordion-toggle inline-flex items-center justify-center w-7 h-7 shrink-0 rounded-full border border-border-highlight bg-[rgba(3,3,138,0.5)] text-accent-blue">
            <i class="accordion-toggle-icon ph ph-plus text-sm leading-none"></i>
          </span>
        </header>
        <div class="accordion-body hidden px-6 pb-5 pt-3 font-sans text-sm md:text-base text-text-primary/85 leading-relaxed">
          <RichText text={faq.body} />
        </div>
      </li>
    ))
  }
</ul>

<script is:inline data-astro-rerun>
  (() => {
  const items = document.querySelectorAll(".accordion-item");

  items.forEach((item) => {
    const header = item.querySelector(".accordion-header");
    const body = item.querySelector(".accordion-body");
    if (!header || !body) return;

    header.addEventListener("click", () => {
      const isActive = item.classList.toggle("active");
      body.classList.toggle("hidden", !isActive);
      const icon = item.querySelector(".accordion-toggle-icon");
      if (icon) {
        icon.classList.toggle("ph-plus", !isActive);
        icon.classList.toggle("ph-minus", isActive);
      }

      items.forEach((other) => {
        if (other !== item) {
          other.classList.remove("active");
          other.querySelector(".accordion-body")?.classList.add("hidden");
          const otherIcon = other.querySelector(".accordion-toggle-icon");
          if (otherIcon) {
            otherIcon.classList.add("ph-plus");
            otherIcon.classList.remove("ph-minus");
          }
        }
      });
    });
  });
  })();
</script>
<style>
  li.active {
    @apply border-border-highlight;
  }
  li.active .accordion-header {
    background-color: rgba(3, 3, 138, 0.25);
  }
  li.active .accordion-title {
    @apply text-accent-yellow;
  }
</style>
