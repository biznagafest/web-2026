---
import type { JobOffer } from "../data/data.type";
import RichText from "./RichText.astro";

interface Props {
  jobOffer: JobOffer;
}

const { jobOffer } = Astro.props;
---

<div
  class="rounded-md w-full border border-border bg-surface-card p-5 transition-colors hover:border-border-highlight"
>
  <div class="flex flex-col justify-between h-full gap-4">
    <div class="flex flex-col gap-2">
      <h4 class="font-heading text-lg font-bold uppercase text-text-primary">
        {jobOffer.title}
      </h4>
      <div
        class="font-sans text-sm text-text-primary/85 flex flex-col gap-2"
      >
        <RichText text={jobOffer.description} />
      </div>
    </div>
    <a
      href={jobOffer.url}
      class="inline-flex w-fit items-center gap-2 rounded-sm border border-border-highlight px-4 py-2 font-sans text-xs font-semibold uppercase tracking-wide text-text-primary transition-colors hover:bg-accent-blue/15"
    >
      Apply
    </a>
  </div>
</div>
