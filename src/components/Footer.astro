---
import { Image } from "astro:assets";

import Socials from "./Socials.astro";

const { data } = Astro.locals;
---

<footer class="bg-surface-page border-t border-border">
  <div
    class="mx-auto max-w-[1240px] flex flex-col gap-10 px-6 py-12 md:py-16 md:grid md:grid-cols-[1fr_2fr_1fr]"
  >
    <div class="flex flex-col items-center md:items-start gap-4">
      <a
        aria-label="Ir a la página de inicio"
        href="/"
        data-umami-event="footer_logo_click"
        class="block"
      >
        <Image
          src="/logo.svg"
          alt="Logo of Biznagafest"
          width={200}
          height={40}
          class="invert h-10 w-auto"
        />
      </a>
      <span class="font-display text-[10px] uppercase tracking-pixel text-text-secondary">
        &copy; {data.title}
      </span>
      <Socials socials={data.socials} />
    </div>

    <nav class="flex flex-col items-center md:items-start gap-3">
      <span
        class="font-display text-[10px] uppercase tracking-pixel text-text-secondary"
      >
        Navega
      </span>
      <ul
        class="flex flex-col md:flex-row md:flex-wrap items-center md:items-start gap-x-6 gap-y-2"
      >
        {
          data.footerLinks.map((link) => (
            <li>
              <a
                class="font-sans text-sm text-text-primary/85 hover:text-accent-yellow transition-colors"
                href={link.href}
                data-umami-event="footer_link_click"
              >
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      !!data.previousEditions.length && (
        <div class="flex flex-col items-center md:items-start gap-3">
          <span class="font-display text-[10px] uppercase tracking-pixel text-text-secondary">
            Ediciones anteriores
          </span>
          <ul class="flex flex-row flex-wrap gap-x-3 gap-y-2 justify-center md:justify-start">
            {data.previousEditions.map((prevEd) => (
              <li>
                <a
                  aria-label={`Edición ${prevEd.name}`}
                  href={prevEd.url}
                  data-umami-event="footer_previous_edition_click"
                  class="inline-flex items-center justify-center rounded-sm border border-border px-2.5 py-1 font-display text-[10px] text-text-primary/80 hover:border-accent-yellow hover:text-accent-yellow transition-colors"
                >
                  {prevEd.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</footer>
