---
import { Image } from "astro:assets";
import type { Speaker } from "../data/data.type";

interface Props {
  speaker: Speaker;
  index: number;
}

const { speaker, index } = Astro.props;
---

<a
  aria-label={`Go to ${speaker.name}'s profile`}
  href={`/speaker/${index}`}
  data-umami-event="speaker_profile_click"
  class="flex flex-col rounded-md bg-surface-card overflow-hidden shadow-card transition-all duration-300 hover:-translate-y-1"
>
  <div
    transition:name={`picture-speaker-${index}`}
    class="relative aspect-[292/240] w-full overflow-hidden bg-surface-page"
  >
    <Image
      src={speaker.picture}
      alt={`Picture of ${speaker.name}`}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500"
      style="-webkit-user-drag: none;"
      height={240}
      width={292}
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-card/5 to-surface-card pointer-events-none"
      aria-hidden="true"
    >
    </div>
  </div>
  <div class="flex flex-col gap-1 px-4 py-3">
    <h3
      transition:name={`name-speaker-${index}`}
      class="font-heading text-xl font-bold tracking-wide text-text-primary leading-tight truncate"
    >
      {speaker.name}
    </h3>
    {
      speaker.position && (
        <span class="font-sans text-[13px] text-text-secondary/80 truncate">
          {speaker.position}
        </span>
      )
    }
  </div>
</a>
