---
import { Image } from "astro:assets";
import type { Raffle } from "../data/data.type";
import RichText from "./RichText.astro";
interface Props {
  raffle: Raffle;
  isEven: boolean;
}

const { raffle, isEven } = Astro.props;
---

<article class={isEven ? "bg-surface-card" : "bg-surface-page"}>
  <div
    class:list={[
      "mx-auto max-w-[1240px] flex flex-col gap-8 md:gap-12 items-center px-6 py-16 md:py-24",
      isEven ? "md:flex-row-reverse" : "md:flex-row",
    ]}
  >
    <Image
      class="w-full md:w-1/2 aspect-square object-cover rounded-md border border-border max-h-[500px]"
      src={raffle.picture}
      alt="Raffle image"
      height={500}
      width={500}
    />
    <div
      class="flex flex-col md:w-1/2 gap-4 font-sans text-base text-text-primary/90 [&>h1]:font-heading [&>h1]:text-3xl [&>h1]:font-bold [&>h1]:uppercase [&>h1]:text-text-primary [&>h4]:font-heading [&>h4]:text-2xl [&>h4]:text-text-primary [&>h5]:font-heading [&>h5]:text-xl [&>h5]:text-text-primary"
    >
      <RichText text={raffle.description} />
    </div>
  </div>
</article>
