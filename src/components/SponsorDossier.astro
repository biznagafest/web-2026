---
import type { SponssorsDossier } from "../data/data.type";

interface Props {
  dossier: SponssorsDossier;
  class?: string;
}

const { dossier } = Astro.props;
---

{
  dossier.enabled && (
    <article class:list={[Astro.props.class]}>
      <a
        href={dossier.es}
        target="_blank"
        data-umami-event="sponsor_dossier_download_es"
        class="inline-flex items-center gap-3 rounded-sm border border-accent-yellow bg-surface-card px-4 py-3 transition-colors hover:bg-accent-yellow/10"
      >
        <i class="ph ph-file-arrow-down text-accent-yellow text-2xl" />
        <span class="font-display text-xs uppercase tracking-pixel text-accent-yellow">
          Ver dossier de patrocinio
        </span>
      </a>
      <a
        href={dossier.en}
        target="_blank"
        data-umami-event="sponsor_dossier_download_en"
        class="mt-2 inline-block font-sans text-xs text-text-secondary hover:text-accent-yellow transition-colors"
      >
        View sponsorship dossier (EN).
      </a>
    </article>
  )
}
