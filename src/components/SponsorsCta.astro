---
interface Props {
  title: string;
  description: string;
  ctaHref: string;
  ctaLabel: string;
}

const { title, description, ctaHref, ctaLabel } = Astro.props;
---

<aside
  class="w-full bg-gradient-to-r from-[#03038a] via-[#0000a6] to-[#03038a]"
>
  <div
    class="mx-auto max-w-[1240px] flex flex-col items-center justify-center gap-8 px-6 py-12 md:py-16 text-center"
  >
    <div class="flex flex-col items-center gap-3 max-w-2xl">
      <h3
        class="font-heading font-bold text-2xl md:text-4xl text-text-primary leading-tight"
      >
        {title}
      </h3>
      <p class="font-sans text-sm md:text-base text-text-primary/90">
        {description}
      </p>
    </div>
    <a
      href={ctaHref}
      data-umami-event="sponsors_cta_click"
      class="inline-flex items-center justify-center rounded-sm bg-action-primary px-6 py-3 font-sans text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-action-primary-hover"
    >
      {ctaLabel}
    </a>
  </div>
</aside>
