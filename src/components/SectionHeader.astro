---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "left",
  class: className = "",
} = Astro.props;
---

<header
  class:list={[
    "flex flex-col gap-3",
    align === "center" ? "items-center text-center" : "items-start text-left",
    className,
  ]}
>
  <div class="flex flex-col gap-1">
    {
      eyebrow && (
        <span class="font-display text-[10px] md:text-[11px] uppercase tracking-pixel text-text-secondary">
          {eyebrow}
        </span>
      )
    }
    <h2
      class="font-heading font-bold uppercase text-3xl md:text-4xl lg:text-5xl text-text-primary leading-tight"
    >
      {title}
    </h2>
  </div>
  <span
    aria-hidden="true"
    class="block h-[3px] w-14 rounded-sm bg-gradient-to-r from-accent-yellow to-accent-red"
  ></span>
  {
    subtitle && (
      <p class="font-sans text-base md:text-lg text-text-primary/80 max-w-3xl">
        {subtitle}
      </p>
    )
  }
</header>
